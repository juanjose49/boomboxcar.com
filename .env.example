NODE_ENV=production
SQUARE_ENVIRONMENT=sandbox
SQUARE_ACCESS_TOKEN=REPLACE_WITH_SQUARE_SANDBOX_ACCESS_TOKEN
SQUARE_APPLICATION_ID=REPLACE_WITH_SQUARE_SANDBOX_APPLICATION_ID
SQUARE_LOCATION_ID=REPLACE_WITH_SQUARE_LOCATION_ID
SQUARE_API_VERSION=2026-07-15
SQUARE_TEAM_MEMBER_IDS=REPLACE_WITH_COMMA_SEPARATED_TEAM_MEMBER_IDS
SQUARE_SERVICE_VARIATION_1H=REPLACE_WITH_1H_VARIATION_ID
SQUARE_SERVICE_VARIATION_2H=REPLACE_WITH_2H_VARIATION_ID
SQUARE_SERVICE_VARIATION_3H=REPLACE_WITH_3H_VARIATION_ID
SQUARE_SERVICE_VARIATION_4H=REPLACE_WITH_4H_VARIATION_ID
SQUARE_SERVICE_VARIATION_8H=REPLACE_WITH_8H_VARIATION_ID
SQUARE_WEBHOOK_SIGNATURE_KEY=REPLACE_WITH_SQUARE_WEBHOOK_SIGNATURE_KEY
SQUARE_WEBHOOK_NOTIFICATION_URL=https://boomboxcar.com/api/webhooks/square
# Server-only JSON. Use a random 22+ character token; never commit live invitations.
# Example: [{"token":"REPLACE_WITH_RANDOM_OPAQUE_TOKEN","code":"DTSS26","name":"Downtown Silver Spring","venueAddress":{"addressLine1":"123 Main St","addressLine2":"","locality":"Silver Spring","administrativeDistrictLevel1":"MD","postalCode":"20910"},"maxHours":4,"valueCap":599,"futureDiscountPercent":15,"newCustomerDiscountPercent":10,"newCustomerOfferEndsOn":"2026-09-30","expiresOn":"2026-12-31","sourceReferralId":"DTSS26","qrCampaignId":"DTSS26-EVENT"}]
BOOMBOXCAR_PARTNERS=[]
BOOMBOXCAR_ADMIN_USERNAME=REPLACE_WITH_ADMIN_USERNAME
BOOMBOXCAR_ADMIN_PASSWORD=REPLACE_WITH_LONG_RANDOM_ADMIN_PASSWORD
APP_BASE_URL=https://boomboxcar.com
ALLOWED_ORIGIN=https://boomboxcar.com
